# Copy to .env.local for development. Never commit real values.

# --- Storefront (server-side only unless prefixed NEXT_PUBLIC_) ---
WORDPRESS_URL=http://localhost:8089            # internal WooCommerce URL (Store API). In k8s: http://wordpress:80
NEXT_PUBLIC_SITE_URL=http://localhost:3000     # canonical public URL (production: https://shomaaa.ir)
NEXT_PUBLIC_DEMO_MODE=1                        # 1 = demo storefront (no real payment); 0 hides the demo notices
REVALIDATE_SECRET=change-me-min-16-chars       # protects POST /api/revalidate
NEWSLETTER_DIR=.data                           # where newsletter subscriptions (JSONL) are stored
INSECURE_COOKIES=1                             # dev/test over http only; never set in production
# DISABLE_RATE_LIMIT=1                         # automated test runs only

# --- AI product photography (scripts/generate-images.mjs) ---
OPENROUTER_API_KEY=                            # https://openrouter.ai/keys — never commit
IMAGE_MODEL=google/gemini-nano-banana-2.1

# --- Local docker-compose backend only ---
# DEV_DB_PASSWORD=...  DEV_DB_ROOT_PASSWORD=...  DEV_WP_ADMIN_PASSWORD=...  WP_PORT=8089
